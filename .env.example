# ============================================================
# Shopflar environment
# Copy this file to .env and fill in your own values.
# Never commit the real .env — it is git-ignored.
# ============================================================

# --- Database -------------------------------------------------
# SQLite (default): a file on a persistent disk
DATABASE_URL="file:./db/custom.db"
# PostgreSQL example:
# DATABASE_URL="postgresql://user:password@host:5432/shopflar"

# --- Auth -----------------------------------------------------
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Demo mode ------------------------------------------------
# false (default): normal store, nothing is ever reset automatically.
# true: disposable demo. A demo admin + sample catalogue are seeded, and the
#       database is wiped and reseeded after DEMO_RESET_MINUTES of inactivity.
DEMO_MODE="false"
DEMO_RESET_MINUTES="30"

# Optional: change the demo admin login (defaults shown).
# DEMO_ADMIN_EMAIL="demo@shopflar.dev"
# DEMO_ADMIN_PASSWORD="demo12345"

# --- AI assistant (Sidekick) ----------------------------------
# Any OpenAI-compatible chat completions endpoint. The key stays server-side.
# Set this in your hosting provider's secret manager — never in git.
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL=""

# --- Optional integrations ------------------------------------
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""

# Set to "none" when the app is embedded cross-site (e.g. preview iframes).
# Requires HTTPS; leave unset for regular SameSite=Lax cookies.
# SESSION_COOKIE_SAMESITE="none"
