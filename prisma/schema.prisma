// Prisma schema for self-hostable ecommerce platform
// Compatible with both SQLite (local dev) and PostgreSQL/Supabase (production)
// To use Supabase: change provider to "postgresql" and set DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Switch to "postgresql" when deploying to Supabase
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ AUTH & USERS ============

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String?
  name           String?
  role           String   @default("CUSTOMER") // CUSTOMER | ADMIN | SUPER_ADMIN
  emailVerified  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile        Profile?
  addresses      Address[]
  orders          Order[]
  cart            Cart?
  reviews        ProductReview[]
  wishlist       WishlistItem[]
  discountUsage  DiscountUsage[]
  verificationTokens VerificationToken[]
}

// One-time tokens for email verification (and future password resets).
// Only the SHA-256 hash of the token is stored — the raw token only ever
// exists inside the emailed link.
model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  type      String   @default("email_verify") // email_verify | password_reset
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
  @@index([userId, type])
}

model Profile {
  id        String  @id @default(cuid())
  userId    String  @unique
  firstName String?
  lastName  String?
  phone     String?
  avatarUrl String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  firstName String
  lastName  String
  company   String?
  address1  String
  address2  String?
  city      String
  state     String?
  postalCode String
  country   String
  phone     String?
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// ============ CATALOG ============

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    ProductCategory[]

  @@map("categories")
}

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  shortDescription String?
  status         String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  featured       Boolean  @default(false)
  sku            String?
  barcode        String?
  price          Float
  compareAtPrice Float?
  costPrice      Float?
  currency       String   @default("USD")
  inventoryQty   Int      @default(0)
  lowStockThreshold Int @default(5)
  trackInventory Boolean  @default(true)
  isOutOfStock   Boolean  @default(false)
  weight         Float?
  length         Float?
  width          Float?
  height         Float?
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  publishedAt    DateTime?
  // Product type: physical (default), downloadable (digital file), code (license/gift card pool)
  productType   String   @default("physical") // physical | downloadable | code
  downloadUrl   String?  // for downloadable products (file URL or Supabase storage path)
  downloadLimit Int      @default(0) // 0 = unlimited
  codePool      String?  // JSON array of codes for "code" type products
  codePoolDelivered String? // JSON array of codes already assigned to orders
  // EU compliance fields (GPSR / Textile Labelling)
  fibreComposition String?  // e.g., "100% cotton" or "80% cotton, 20% polyester"
  countryOfOrigin String?   // e.g., "Made in Bangladesh"
  manufacturerName String?  // manufacturer name for safety compliance
  manufacturerAddress String? // manufacturer address
  safetyWarnings String?   // product safety warnings (JSON array of strings)
  careInstructions String?  // care instructions text
  warrantyInfo String?      // warranty info (defaults to EU 2-year statutory warranty)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categories     ProductCategory[]
  images         ProductImage[]
  variants       ProductVariant[]
  reviews        ProductReview[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  printifyLink   PrintifyProductLink?
  tags           ProductTag[]
  wishlistItems  WishlistItem[]
  mysteryCrate   MysteryCrate?

  @@map("products")
  @@index([status])
  @@index([featured])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model ProductTag {
  id        String  @id @default(cuid())
  productId String
  tag       String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_tags")
  @@index([tag])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id           String  @id @default(cuid())
  productId    String
  sku          String?
  name         String
  options      String // JSON string like {"Size":"M","Color":"Red"}
  price        Float?
  inventoryQty Int @default(0)
  weight       Float?
  barcode      String?
  isActive     Boolean @default(true)
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  orderItems   OrderItem[]
  printifyLink PrintifyVariantLink?

  @@map("product_variants")
}

model ProductReview {
  id        String  @id @default(cuid())
  productId String
  userId    String?
  authorName String
  rating    Int
  title     String?
  body      String?
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("product_reviews")
}

// ============ CART ============

model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  guestId   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id         String  @id @default(cuid())
  cartId     String
  productId  String
  variantId  String?
  quantity   Int
  createdAt  DateTime @default(now())
  cart       Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("cart_items")
}

// ============ ORDERS ============

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  userId          String?
  email           String
  status          String   @default("PENDING") // PENDING | PAYMENT_PENDING | PAID | PROCESSING | SHIPPED | DELIVERED | CANCELLED | REFUNDED | FAILED
  paymentStatus   String   @default("UNPAID") // UNPAID | PAID | REFUNDED | PARTIALLY_REFUNDED
  fulfillmentStatus String @default("UNFULFILLED")
  subtotal        Float
  discountTotal   Float    @default(0)
  shippingTotal   Float    @default(0)
  taxTotal        Float    @default(0)
  total           Float
  currency        String   @default("USD")
  discountCode    String?
  shippingMethod  String?
  trackingNumber  String?
  notes           String?
  internalNotes   String?
  billingAddress  Json?
  shippingAddress Json?
  paymentProvider String?
  paymentRef      String?
  printifyOrderId String?
  // Mystery crate reveal data (JSON): what the customer won, per crate
  mysteryReveals  String?
  // Free Order Dice game (rolled once, server-side, after payment)
  diceRoll        Int?      // 1..sides
  diceTarget      Int?      // winning number at roll time
  diceWon         Boolean   @default(false)
  diceCouponCode  String?   // coupon issued on a win
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payments        Payment[]
  discountUsage   DiscountUsage[]

  @@map("orders")
  @@index([status])
  @@index([email])
  @@index([userId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  variantId   String?
  name        String
  sku         String?
  variantName String?
  price       Float
  quantity    Int
  imageUrl    String?
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String
  provider      String   // stripe | paypal
  amount        Float
  currency      String   @default("USD")
  status        String   @default("PENDING") // PENDING | SUCCEEDED | FAILED | REFUNDED
  reference     String?
  rawResponse   String?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ============ DISCOUNTS ============

model Discount {
  id              String   @id @default(cuid())
  code            String   @unique
  type            String   // PERCENTAGE | FIXED_AMOUNT | FREE_SHIPPING
  value           Float    @default(0)
  minOrderAmount  Float?
  maxDiscount     Float?
  startDate       DateTime?
  endDate         DateTime?
  usageLimit      Int?
  perCustomerLimit Int?
  usedCount       Int      @default(0)
  isActive        Boolean  @default(true)
  source          String   @default("manual") // manual | dice | newsletter
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  usage          DiscountUsage[]

  @@map("discounts")
}

model DiscountUsage {
  id         String   @id @default(cuid())
  discountId String
  orderId    String
  userId     String?
  createdAt  DateTime @default(now())
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("discount_usage")
}

// ============ SHIPPING & TAX ============

model ShippingMethod {
  id              String   @id @default(cuid())
  name            String
  description     String?
  price           Float
  freeShippingThreshold Float?
  countries       String   // JSON array of country codes; "ALL" for any
  estimatedDays   String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("shipping_methods")
}

model TaxRate {
  id        String   @id @default(cuid())
  country  String
  region   String?
  rate     Float     // percentage (e.g., 8.5)
  name     String?
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tax_rates")
}

// ============ NEWSLETTER ============

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  isActive  Boolean  @default(true)
  source    String   @default("STOREFRONT")
  token     String   @unique @default(cuid()) // unsubscribe token
  unsubscribedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscribers")
}

// ============ NEWSLETTER CAMPAIGNS ============

model NewsletterCampaign {
  id              String   @id @default(cuid())
  subject         String
  preheader       String?  // preview text shown after the subject in inboxes
  mode            String   @default("blocks") // blocks | image
  blocks          String?  // JSON array of content blocks (mode=blocks)
  imageUrl        String?  // full-width image (mode=image)
  clickUrl        String?  // where the image links to (mode=image)
  imageAlt        String?
  accentColor     String   @default("#1a1a1a") // header / button color
  status          String   @default("draft") // draft | sending | sent | partial | failed
  totalRecipients Int      @default(0)
  sentCount       Int      @default(0)
  failedCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  sentAt          DateTime?
  recipients      NewsletterRecipient[]

  @@map("newsletter_campaigns")
}

model NewsletterRecipient {
  id         String    @id @default(cuid())
  campaignId String
  email      String
  status     String    @default("pending") // pending | sent | failed
  error      String?
  sentAt     DateTime?
  campaign   NewsletterCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@map("newsletter_recipients")
}

// ============ STORE SETTINGS ============

model StoreSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  updatedAt DateTime @updatedAt

  @@map("store_settings")
}

model AppearanceSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  updatedAt DateTime @updatedAt

  @@map("appearance_settings")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId   String
  productId String
  createdAt DateTime @default(now())
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("wishlist_items")
  @@unique([userId, productId])
}

// ============ PRINTIFY ============

model PrintifyProductLink {
  id                String  @id @default(cuid())
  productId         String  @unique
  printifyProductId String
  printifyShopId    String?
  lastSyncedAt      DateTime?
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("printify_product_links")
}

model PrintifyVariantLink {
  id                     String  @id @default(cuid())
  productVariantId       String  @unique
  printifyVariantId      String
  printifyProductId      String
  productVariant         ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@map("printify_variant_links")
}

model PrintifyShop {
  id          String   @id @default(cuid())
  shopId      String   @unique
  name        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("printify_shops")
}

// ============ AUDIT LOG ============

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorEmail String?
  action    String
  entity    String?
  entityId  String?
  metadata  String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// ============ CUSTOM PAGES (site builder) ============

model CustomPage {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   // HTML or markdown
  excerpt     String?
  status      String   @default("PUBLISHED") // DRAFT | PUBLISHED
  showInNav   Boolean  @default(false)
  navLabel    String?
  sortOrder   Int      @default(0)
  seoTitle    String?
  seoDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("custom_pages")
}

// ============ PLUGINS ============

model Plugin {
  id          String   @id @default(cuid())
  slug        String   @unique  // e.g. "mystery-crate"
  name        String
  description String?
  enabled     Boolean  @default(false)
  config      String?  // JSON string of plugin-specific config
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("plugins")
}

// ============ MYSTERY CRATE PLUGIN ============
// A mystery crate is a product that, when purchased, includes random items
// from a configured pool with specified probabilities.

model MysteryCrate {
  id          String   @id @default(cuid())
  productId   String   @unique
  guaranteedItems String // JSON: [{productId, quantity}] — always included
  poolItems   String   // JSON: [{productId, weight}] — chance-based items
  poolSize    Int      @default(1) // how many random items from pool to include
  showOdds    Boolean  @default(false) // show the "Odds" button on the product page
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("mystery_crates")
}

// ============ COOKIE CONSENT ============

model CookieConsent {
  id          String   @id @default(cuid())
  visitorId   String   @unique
  consent     String   // "all" | "essential" | "none"
  categories  String   // JSON: ["essential","analytics","marketing"]
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cookie_consents")
}

// ============ PAGE SECTIONS (page builder) ============
// Sections are stored as a JSON array in the page's `sections` field.
// Each section has: { id, type, config, sortOrder }
// Section types: hero, product-grid, marquee, text, image, newsletter, custom-html, categories

model PageSection {
  id          String   @id @default(cuid())
  pageType    String   @default("home") // home | product | custom
  pageId      String?  // for custom pages, references CustomPage.id
  sectionType String   // hero | product-grid | marquee | text | image | newsletter | custom-html | announcement-bar | image-text | testimonials | faq | video | rich-text
  config      String   // JSON config for the section (published version)
  draftConfig String?  // JSON config for the section (draft version, null = no draft changes)
  sortOrder   Int      @default(0)
  draftSortOrder Int?  // null = no draft change
  isVisible   Boolean  @default(true)
  isDraft     Boolean  @default(false) // true = newly added in draft, not yet published
  isDeleted   Boolean  @default(false) // true = marked for deletion in draft
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("page_sections")
  @@index([pageType, pageId])
}

// ============ DIGITAL FULFILLMENT ============
// Tracks download links and codes delivered with each order

model OrderFulfillment {
  id          String   @id @default(cuid())
  orderId     String
  orderItemId String
  productId   String
  fulfillmentType String // download_link | code
  downloadUrl String?
  downloadLimit Int @default(0)
  downloadCount Int @default(0)
  code        String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@map("order_fulfillments")
  @@index([orderId])
}

// ============ EMAIL LOG ============

model EmailLog {
  id          String   @id @default(cuid())
  to          String
  subject     String
  body        String
  status      String   @default("pending") // pending | sent | failed
  error       String?
  createdAt   DateTime @default(now())

  @@map("email_logs")
}
