# Copy to .env.docker, fill in the values, then run:
#   docker compose --env-file .env.docker up -d --build
# Never commit .env.docker.

# --- Required -------------------------------------------------
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=

# Public URL of this deployment (HTTPS in production). Used for auth
# callbacks, absolute image/email links, and Stripe redirects.
NEXTAUTH_URL=https://demo.example.com
APP_URL=https://demo.example.com
NEXT_PUBLIC_APP_URL=https://demo.example.com

# --- Storage --------------------------------------------------
# The image defaults to this. The path must be inside the mounted volume.
DATABASE_URL=file:/data/shopflar.db

# --- Demo mode ------------------------------------------------
# true: disposable demo that reseeds after DEMO_RESET_MINUTES of inactivity.
DEMO_MODE=true
DEMO_RESET_MINUTES=30
# Optional demo admin overrides (defaults: demo@shopflar.dev / demo12345).
# DEMO_ADMIN_EMAIL=demo@shopflar.dev
# DEMO_ADMIN_PASSWORD=demo12345

# --- AI assistant (optional) ----------------------------------
# Key stays server-side. Leave empty to hide/disable the assistant.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# --- Optional integrations ------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Set to "none" only when the app is embedded cross-site in an iframe.
# Requires HTTPS. Leave unset for normal top-level deployments.
# SESSION_COOKIE_SAMESITE=none

# --- Container behaviour --------------------------------------
# Apply the Prisma schema on every boot. Set false after the first boot if
# you prefer to run migrations yourself.
RUN_DB_PUSH=true
PORT=3000
